# Configuração de servidor para o Supabase self-hosted.
# Não inserir credenciais reais neste arquivo.
# Sem NEXT_PUBLIC_: estas variáveis não devem ser expostas ao navegador.
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Integração real permanece desativada até autorização e testes.
# Não configure service_role no navegador.
